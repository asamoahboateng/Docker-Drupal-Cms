# ---------------------------------------------------------------
# Copy this file to .env (./setup.sh does it for you and fills in
# random passwords). NEVER commit .env — it holds your secrets.
# ---------------------------------------------------------------

# Name prefix for containers/volumes.
COMPOSE_PROJECT_NAME=drupalcms

# Extra services to start. Comma separated:
#   tunnel -> Cloudflare Tunnel (needs CLOUDFLARE_TUNNEL_TOKEN)
#   tools  -> Adminer database UI on http://localhost:8091
COMPOSE_PROFILES=

# Your user/group id, so files created by Drupal belong to you.
# setup.sh fills these in automatically.
HOST_UID=1000
HOST_GID=1000

# Where the site is reachable on your computer: http://localhost:8080
# Use HTTP_BIND=0.0.0.0 to allow other devices on your network.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
MAILPIT_PORT=8025
ADMINER_PORT=8091

# Database
DB_NAME=drupal
DB_USER=drupal
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# Drupal
DRUPAL_HASH_SALT=change-me
# Every domain the site answers on, comma separated (add your tunnel domain!)
DRUPAL_TRUSTED_HOSTS=localhost,127.0.0.1
# Leave empty for the latest Drupal CMS, or pin e.g. ^2.0
DRUPAL_CMS_VERSION=

# ---------------- Outgoing e-mail ----------------
# MAIL_TRANSPORT=mailpit -> all mail is caught by Mailpit (http://localhost:8025), nothing leaves.
# MAIL_TRANSPORT=smtp    -> mail is really sent using the SMTP_* values below.
# After changing, run:  docker compose up -d
MAIL_TRANSPORT=mailpit

# Your provider's SMTP details (only used when MAIL_TRANSPORT=smtp).
#   Port 587 -> SMTP_TLS=on  SMTP_STARTTLS=on
#   Port 465 -> SMTP_TLS=on  SMTP_STARTTLS=off
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=on
SMTP_STARTTLS=on
# Sender address; must be allowed/verified by your provider.
SMTP_FROM=noreply@example.com

# Cloudflare Tunnel token (Zero Trust dashboard -> Networks -> Tunnels).
CLOUDFLARE_TUNNEL_TOKEN=
